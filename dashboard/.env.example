# ============================================================
# SMART BELL IoT - Dashboard Environment Variables
# ============================================================
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env ke Git.

# URL project Supabase (contoh: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Anon public key Supabase (untuk client-side)
VITE_SUPABASE_ANON_KEY=

# URL Audio Server / Cloudflare Quick Tunnel (contoh: https://xxxx.trycloudflare.com atau http://localhost:3000)
VITE_AUDIO_SERVER_URL=
